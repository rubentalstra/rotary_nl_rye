    <string name="about_motto">To build peace one young person at a time.</string>
    <string name="about_who_we_are_title">Who we are</string>
    <string name="about_who_we_are_body">Rotary has organised international youth exchanges for 55 years. Youth exchange is in Rotary\'s DNA: young people hold the future, for Rotary and for the world. Since 2010, youth service with youth exchange has been Rotary\'s fifth Avenue of Service. Every year there are 7,000 exchanges worldwide. In the Netherlands, the Multi-District Youth Committee (MDJC) organises them.</string>
    <string name="about_who_we_are_point_1">International understanding and peace, by connecting young people around the world</string>
    <string name="about_who_we_are_point_2">Personal growth: stepping out of your comfort zone, becoming independent and adapting to new surroundings</string>
    <string name="about_who_we_are_point_3">Cultural exchange: learning the language, customs and habits of another country</string>
    <string name="about_who_we_are_point_4">Being an ambassador: you represent your own country and culture in your host country</string>
    <string name="about_mission_title">Our mission</string>
    <string name="about_mission_body">Rotary Youth Exchange gives young people the chance to live abroad for a year or less, go to school there and discover a new culture.</string>
    <string name="about_mission_point_1">International understanding and peace, by connecting young people around the world</string>
    <string name="about_mission_point_2">Personal growth: stepping out of your comfort zone, becoming independent and adapting to new surroundings</string>
    <string name="about_mission_point_3">Cultural exchange: learning the language, customs and habits of another country</string>
    <string name="about_mission_point_4">Being an ambassador: you represent your own country and culture in your host country</string>
    <string name="about_programmes_title">Exchange programmes</string>
    <string name="about_programmes_point_1">Long Term Exchange: 10 to 11 months</string>
    <string name="about_programmes_point_2">Short Term Exchange: twice two weeks (northern hemisphere) or twice four weeks (southern hemisphere)</string>
    <string name="about_programmes_point_3">Summer camps</string>
    <string name="about_values_title">Values</string>
    <string name="about_values_point_1">Understanding of and respect for other cultures</string>
    <string name="about_values_point_2">Personal growth and development</string>
    <string name="about_values_point_3">Friendship and peace around the world</string>
    <string name="about_values_point_4">Service above self</string>

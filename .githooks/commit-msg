#!/usr/bin/env bash
# .githooks/commit-msg (install: git config core.hooksPath .githooks)
#
# Strips any AI / assistant attribution from the commit message before it is
# recorded. Commit text describes the change and nothing else. Always exits 0:
# the message is rewritten, never refused.

set -euo pipefail

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

strip_patterns=(
  '^[[:space:]]*Co-authored-by:.*[Cc]laude'
  '^[[:space:]]*Co-authored-by:.*[Aa]nthropic'
  '^[[:space:]]*Co-authored-by:.*noreply@anthropic\.com'
  '^[[:space:]]*Co-authored-by:.*\[bot\]'
  '[Gg]enerated[[:space:]]+with[[:space:]]+.*[Cc]laude'
  '[Gg]enerated[[:space:]]+by[[:space:]]+.*[Cc]laude'
  '[Cc]laude[[:space:]]+[Cc]ode'
  '🤖'
  '^[[:space:]]*Assisted-by:.*[Cc]laude'
  '^[[:space:]]*Signed-off-by:.*[Cc]laude'
  'Anthropic[[:space:]]+Claude'
)

tmp="$(mktemp)"
cp "$MSG_FILE" "$tmp"
for pat in "${strip_patterns[@]}"; do
  grep -viE "$pat" "$tmp" > "$tmp.next" || true
  mv "$tmp.next" "$tmp"
done
# Collapse the blank lines a removed trailer leaves behind.
cat -s "$tmp" > "$MSG_FILE"
rm -f "$tmp"
exit 0

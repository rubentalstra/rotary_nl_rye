# Describes the files as they are; it never asks for a reformat.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Swift, Kotlin and Python: 4 spaces (Xcode's and Android Studio's indentation).
[*.{swift,kt,kts,py}]
indent_style = space
indent_size = 4

# Shell, YAML, the String Catalogs and the JSON Xcode writes: 2 spaces.
[*.{sh,yml,yaml,xcstrings,json,resolved}]
indent_style = space
indent_size = 2

[.githooks/*]
indent_style = space
indent_size = 2

# Xcode writes the project file with tabs.
[*.pbxproj]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# The archived app keeps the formatting it had; licence texts are verbatim.
[{archive/**,LICENSE,**.svg}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

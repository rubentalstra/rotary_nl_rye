    "Huisbezoek gastgezinnen": {
      "comment": "Rotary clubs: a document's title, the form for visiting host families.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visiting host families"
          }
        }

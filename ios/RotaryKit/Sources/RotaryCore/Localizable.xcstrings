    },
    "Voorzitter Rotary Youth Exchange": {
      "comment": "Role: chair of Rotary Youth Exchange Netherlands.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chair of Rotary Youth Exchange"
          }
        }
      }
    },
    "Vriendschap en vrede wereldwijd": {
      "comment": "About tab: a value of Rotary Youth Exchange.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friendship and peace around the world"
          }
        }
      }
    },
    "Waarden": {
      "comment": "About tab: heading.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values"
          }
        }
      }
    },
    "Wat leuk dat jullie als Rotary-club een jaarstudent willen supporten, en daarmee ook een jaar lang een student uit het buitenland in jullie club ontvangen en begeleiden. Misschien heeft een scholier jullie benaderd, of komt de wens van een van jullie clubleden.": {
      "comment": "Rotary clubs: the welcome at the top of the page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How wonderful that your Rotary club wants to sponsor an exchange student, and so also receive and support a student from abroad in your club for a year. Perhaps a student approached you, or the wish came from one of your members."
          }
        }
      }
    },
    "Wie zijn wij": {
      "comment": "About tab: heading.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who we are"
          }
        }
      }
    },
    "Zomerkampen": {
      "comment": "About tab: an exchange programme.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer camps"
          }
        }
      }
    }
  },
  "version": "1.1"
